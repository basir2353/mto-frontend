{
  "name": "mto_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:local": "node scripts/use-env.mjs local && next dev -p 3000",
    "dev:live": "node scripts/use-env.mjs live && next dev -p 3000",
    "env:local": "node scripts/use-env.mjs local",
    "env:live": "node scripts/use-env.mjs live",
    "env:production": "node scripts/use-env.mjs production",
    "build": "next build",
    "build:live": "node scripts/use-env.mjs production && next build",
    "start": "next start -p 3000",
    "start:prod": "node scripts/use-env.mjs production && next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "apk:open": "npx cap open android",
    "apk:debug": "npx cap sync android && cd android && gradlew.bat assembleDebug --no-daemon"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}

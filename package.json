{
  "name": "mto_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:local": "node scripts/use-env.mjs local && next dev -p 3000",
    "dev:live": "node scripts/use-env.mjs live && next dev -p 3000",
    "env:local": "node scripts/use-env.mjs local",
    "env:live": "node scripts/use-env.mjs live",
    "env:production": "node scripts/use-env.mjs production",
    "build": "next build",
    "build:live": "node scripts/use-env.mjs production && next build",
    "start": "next start -p 3000",
    "start:prod": "node scripts/use-env.mjs production && next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.9.0",
    "lucide-react": "^1.24.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5"
  }
}
